# Copy to .env and replace both placeholders before starting.
# Loaded by Compose automatically; export into your shell for Django (see README).
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
POSTGRES_DB=ordered_cars
POSTGRES_USER=ordered_cars
POSTGRES_PASSWORD=replace-with-a-random-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
